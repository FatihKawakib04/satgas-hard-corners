# Force GitHub Linguist to count the languages that make up this project.
*.astro linguist-detectable=true
*.ts    linguist-detectable=true
*.css   linguist-detectable=true
*.mjs   linguist-detectable=true

# Lockfiles are generated — keep them out of the language bar.
package-lock.json linguist-generated=true

# Research report HTML is generated by Python pipeline (report.py build_html).
# Mark as generated so it doesn't dominate the language statistics.
research/reports/*.html linguist-generated=true
